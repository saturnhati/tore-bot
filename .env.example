# Token del bot Telegram (crealo con @BotFather)
BOT_TOKEN=

# Il TUO Telegram user ID: solo questo utente puo' usare il bot.
# Chiedi il tuo ID a @userinfobot.
OWNER_USER_ID=

# Chiave API OpenCode Go (da https://opencode.ai/auth)
# Usata SOLO per capire i messaggi e suggerire ricette.
LLM_API_KEY=

# Endpoint e modello LLM. Default: OpenCode Go (economico).
# I modelli compatibili con /chat/completions includono:
#   deepseek-v4-flash, hy3, glm-5.2, kimi-k2.6, longcat-2.0, mimo-v2.5, ...
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# Cartella del database (relativa alla root del progetto). Di solito non serve toccarla.
DATA_DIR=./data
